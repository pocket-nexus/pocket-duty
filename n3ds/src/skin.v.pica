; A soldier, or the weapon in the player's hands: each vertex moved by up to
; four bones of its batch and lit by the sun, where it reaches, and the sky.
.fvec mvp[4]
; four bones, three rows each
.fvec bones[12]
; in the figure's own space: toward the sun, and up
.fvec sun
.fvec up
; the sun's colour times how much of it reaches the figure, the sky's from above, the sky's from everywhere
.fvec suncol
.fvec skycol
.fvec ambient
.fvec fog
; 0, 1, 1/128 (a weight's unit), 1/255
.constf consts(0.0, 1.0, 0.0078125, 0.0039215686)
.in inw v0
.in inclr v1
.in innrm v2
.in inpos v3
.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.entry main
.proc main
    mov r0.xyz, inpos.xyz
    mov r0.w, consts.y
    mul r10, consts.zzzz, inw
    ; bone 0
    dp4 r1.x, bones[0], r0
    dp4 r1.y, bones[1], r0
    dp4 r1.z, bones[2], r0
    mul r2.xyz, r10.xxx, r1.xyz
    dp3 r3.x, bones[0], innrm
    dp3 r3.y, bones[1], innrm
    dp3 r3.z, bones[2], innrm
    mul r4.xyz, r10.xxx, r3.xyz
    ; bone 1
    dp4 r1.x, bones[3], r0
    dp4 r1.y, bones[4], r0
    dp4 r1.z, bones[5], r0
    mul r1.xyz, r10.yyy, r1.xyz
    add r2.xyz, r2.xyz, r1.xyz
    dp3 r3.x, bones[3], innrm
    dp3 r3.y, bones[4], innrm
    dp3 r3.z, bones[5], innrm
    mul r3.xyz, r10.yyy, r3.xyz
    add r4.xyz, r4.xyz, r3.xyz
    ; bone 2
    dp4 r1.x, bones[6], r0
    dp4 r1.y, bones[7], r0
    dp4 r1.z, bones[8], r0
    mul r1.xyz, r10.zzz, r1.xyz
    add r2.xyz, r2.xyz, r1.xyz
    dp3 r3.x, bones[6], innrm
    dp3 r3.y, bones[7], innrm
    dp3 r3.z, bones[8], innrm
    mul r3.xyz, r10.zzz, r3.xyz
    add r4.xyz, r4.xyz, r3.xyz
    ; bone 3
    dp4 r1.x, bones[9], r0
    dp4 r1.y, bones[10], r0
    dp4 r1.z, bones[11], r0
    mul r1.xyz, r10.www, r1.xyz
    add r2.xyz, r2.xyz, r1.xyz
    dp3 r3.x, bones[9], innrm
    dp3 r3.y, bones[10], innrm
    dp3 r3.z, bones[11], innrm
    mul r3.xyz, r10.www, r3.xyz
    add r4.xyz, r4.xyz, r3.xyz
    mov r2.w, consts.y
    dp4 r5.x, mvp[0], r2
    dp4 r5.y, mvp[1], r2
    dp4 r5.z, mvp[2], r2
    dp4 r5.w, mvp[3], r2
    mov outpos, r5
    ; the normal at its own length, then the two lights
    dp3 r6.x, r4, r4
    rsq r6.x, r6.x
    mul r4.xyz, r6.xxx, r4.xyz
    dp3 r7.x, sun, r4
    max r7.x, consts.x, r7.x
    dp3 r7.y, up, r4
    max r7.y, consts.x, r7.y
    mul r8.xyz, suncol.xyz, r7.xxx
    add r8.xyz, ambient.xyz, r8.xyz
    mul r9.xyz, skycol.xyz, r7.yyy
    add r8.xyz, r8.xyz, r9.xyz
    mul r9.xyz, consts.www, inclr.xyz
    mul r8.xyz, r9.xyz, r8.xyz
    min r8.xyz, consts.yyy, r8.xyz
    mul r6.x, fog.x, r5.w
    add r6.x, fog.y, r6.x
    max r6.x, consts.x, r6.x
    min r6.x, consts.y, r6.x
    add r8.w, consts.y, -r6.x
    mov outclr, r8
    mov r11, consts.xxxy
    mov outtc0, r11
    mov outtc1, r11
    mov outtc2, r11
    end
.end
